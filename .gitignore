# --- secrets: never commit ---
.voice_password
.voice_password.*
.vercel_token
.env
.env.*
!.env.example
# certs/ is fully generated by make_cert.sh and embeds your LAN IP
certs/

# --- runtime state (contains your conversations) ---
data/
backups/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# --- logs ---
*.log
launchd-*.log

# --- deploy scratch ---
vercel/
.vercel/

# --- python ---
__pycache__/
*.py[cod]
venv/
.venv/

# --- editor / os ---
.DS_Store
.claude/
.idea/
.vscode/

# --- backup copies ---
*.bak
*.bak-*
*.backup-*
